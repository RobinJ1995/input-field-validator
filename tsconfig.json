{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2021"],
		"module": "CommonJS",
		"moduleResolution": "Node",

		"strict": true,
		"noImplicitOverride": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,

		"newLine": "lf",
		"noEmit": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
