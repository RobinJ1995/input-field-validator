{
  "name": "input-field-validator",
  "version": "3.0.0",
  "description": "Input field validator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Validator": {
      "types": "./dist/Validator.d.ts",
      "default": "./dist/Validator.js"
    },
    "./FieldValidator": {
      "types": "./dist/FieldValidator.d.ts",
      "default": "./dist/FieldValidator.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "mocha --require ts-node/register test/*.ts",
    "prepare": "npm run build"
  },
  "author": "Robin Jacobs",
  "license": "GPLv2",
  "repository": {
    "type": "git",
    "url": "https://github.com/RobinJ1995/input-field-validator.git"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/uuid": "^8.3.4",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^8.3.2"
  }
}
